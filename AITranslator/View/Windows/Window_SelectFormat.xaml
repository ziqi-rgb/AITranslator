<Window x:Class="AITranslator.View.Windows.Window_SelectFormat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导入格式" Height="280" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请选择要导入的文件格式（将递归扫描所有子文件夹）：" 
                   Foreground="Gray" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="rb_Csv" GroupName="fmt" Content="" Margin="0,4" 
                         Foreground="Black" FontSize="13" Checked="Radio_Checked"/>
            <RadioButton x:Name="rb_Json" GroupName="fmt" Content="" Margin="0,4" 
                         Foreground="Black" FontSize="13" Checked="Radio_Checked"/>
            <RadioButton x:Name="rb_Srt" GroupName="fmt" Content="" Margin="0,4" 
                         Foreground="Black" FontSize="13" Checked="Radio_Checked"/>
            <RadioButton x:Name="rb_Txt" GroupName="fmt" Content="" Margin="0,4" 
                         Foreground="Black" FontSize="13" Checked="Radio_Checked"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btn_OK" Content="确定" Foreground="Black" Width="72" Height="28" Click="Btn_OK_Click"/>
            <Button x:Name="btn_Cancel" Content="取消" Foreground="Black" Width="72" Height="28" Margin="8,0,0,0" Click="Btn_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
